---
import { Navbar } from "@/components/Navbar/Navbar";
import Footer from "@/components/Footer/Footer.astro";
---

<Navbar client:load />
<main class="min-h-[70vh] flex flex-col items-center justify-center px-6 py-24 text-center">
  <p class="text-brand-primary text-sm uppercase tracking-[0.3em] mb-4">
    404
  </p>
  <h1 class="text-4xl md:text-5xl font-bold uppercase tracking-tight mb-6">
    Page not found
  </h1>
  <p class="text-gray-300/70 max-w-md mb-10">
    The page you are looking for does not exist or may have been moved.
  </p>
  <a
    href="/"
    class="text-brand-primary uppercase tracking-widest text-sm border-b border-brand-primary/30 hover:border-brand-primary transition-colors"
  >
    Back to home
  </a>
</main>
<Footer />
