---
import "@fontsource/urbanist/400";
import "@fontsource/urbanist/500";
import "@fontsource/urbanist/600";
import "@fontsource/urbanist/700";
import "@fontsource/inter/400";
import "@fontsource/inter/600";
import "@fontsource/inter/400-italic";

import "../styles/global.css";
import {
  DEFAULT_DESCRIPTION,
  SITE_NAME,
  buildWebPageSchema,
  getDefaultOgImage,
} from "@/lib/seo";
import { getSiteUrl } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title: titleProp,
  description: descriptionProp,
  canonical: canonicalProp,
  ogType = "website",
  ogImage: ogImageProp,
  publishedTime,
  tags = [],
  noindex = false,
  jsonLd: jsonLdProp,
} = Astro.props;

const title = titleProp ?? SITE_NAME;
const description = descriptionProp ?? DEFAULT_DESCRIPTION;
const canonical = canonicalProp ?? getSiteUrl("/");
const ogImage = ogImageProp ?? getDefaultOgImage();
const jsonLd = jsonLdProp ?? [
  buildWebPageSchema({
    name: title,
    url: canonical,
    description,
  }),
];
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {
      ogType === "article" && publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      ogType === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      jsonLdItems.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0B906R0SN7"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-0B906R0SN7");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
