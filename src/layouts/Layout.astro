---
import "@fontsource/urbanist/400";
import "@fontsource/urbanist/500";
import "@fontsource/urbanist/600";
import "@fontsource/urbanist/700";

import "../styles/global.css";
import { getSiteUrl } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title: titleProp,
  description: descriptionProp,
  canonical: canonicalProp,
} = Astro.props;

const ldSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Yuri Delgado",
  url: getSiteUrl(),
  description:
    "I help you build your MVP and prototype the right way. Ship fast, but ship right.",
};

const titleDefault = titleProp ?? "Yuri Delgado";
const descriptionDefault =
  descriptionProp ??
  "I help you build your MVP and prototype the right way. Ship fast, but ship right.";
const canonicalDefault = canonicalProp ?? getSiteUrl();
const coverImage = getSiteUrl("/images/cover-logo.jpg");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalDefault} />
    <meta name="description" content={descriptionDefault} />
    <meta property="og:title" content={titleDefault} />
    <meta property="og:description" content={descriptionDefault} />
    <meta property="og:image" content={coverImage} />
    <meta property="og:url" content={canonicalDefault} />
    <meta name="twitter:card" content={coverImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(ldSchema)} />
    <meta name="generator" content={Astro.generator} />
    <title>{titleDefault}</title>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0B906R0SN7"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-0B906R0SN7");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
